{
  "name": "dsh-better-input",
  "version": "0.1.0",
  "description": "DSH Web 插件：在模型选择器左侧加一个「AI 优化输入」按钮，按可自定义提示词优化输入框内容，并支持撤销。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "scripts",
    "test",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "link-deps": "node scripts/link-dev-deps.mjs",
    "pretest": "node scripts/link-dev-deps.mjs",
    "test": "node test/smoke.mjs && node test/client.smoke.mjs && node test/settings-activation.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1",
    "@deepseek-ai/schemastery": ">=3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
